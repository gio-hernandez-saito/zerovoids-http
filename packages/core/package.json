{
  "name": "@zerovoids/http-core",
  "version": "0.3.0",
  "description": "Vendor-normalizing HTTP layer — normalize errors from many APIs into one type",
  "keywords": [
    "http",
    "fetch",
    "error-normalization",
    "api-client",
    "typescript"
  ],
  "author": "zerovoids",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gio-hernandez-saito/zerovoids-http.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gio-hernandez-saito/zerovoids-http#readme",
  "bugs": "https://github.com/gio-hernandez-saito/zerovoids-http/issues",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "size-limit": [
    {
      "name": "ESM (full entry)",
      "path": "dist/index.mjs",
      "limit": "2 kB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.21",
    "size-limit": "^13.0.0",
    "tsdown": "^0.23.0",
    "vitest": "^4.1.10"
  }
}
