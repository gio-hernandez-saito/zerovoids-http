{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "zerovoids-http base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // The real build is emitted by tsdown (Rolldown + oxc); tsc only type-checks,
    // hence noEmit. `isolatedDeclarations` forces an explicit type on every export
    // — this makes .d.ts generation fast (oxc can do it without a full type graph)
    // and keeps the public API surface deliberate rather than inferred-and-leaked.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedDeclarations": true,
    "noEmit": true
  }
}
